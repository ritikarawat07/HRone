# Environment variables and secrets
.env*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test, lint, and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.tox/
.nox/
.coverage
htmlcov/

# Build and distribution artifacts
build/
dist/
*.egg-info/

# IDE and editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# Logs and temporary files
*.log
*.log.*
*.tmp

# Database dumps and exports (strictly prohibited in submission)
*.bson
*.bson.gz
*.archive
*.dump
*.sql
*.sqlite
*.sqlite3

# Prohibited container artifacts
Dockerfile*

# Operating system files
.DS_Store
Thumbs.db
